{
  "expo": {
    "name": "Dominó - Marcador",
    "slug": "domino",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "domino",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F14"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "backgroundColor": "#0F0F14"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a Dominó usar una foto de tu galería como fondo de la app."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
